APP_NAME=NITC CCC Terminal Booking Tracker API
APP_ENV=development
API_PREFIX=/api/v1
HOST=127.0.0.1
PORT=8000

# Optional during the API-only scaffold. Add an Atlas URI when database work begins.
MONGODB_URI=
MONGODB_DATABASE=nitc_ccc_tracker
JWT_SECRET_KEY=replace-with-a-long-random-secret-before-running-auth
ACCESS_TOKEN_MINUTES=30
BOOTSTRAP_ADMIN_USERNAME=admin
BOOTSTRAP_ADMIN_PASSWORD=
GMAIL_MAILBOX=
GMAIL_CLIENT_SECRET_FILE=
GMAIL_TOKEN_FILE=token.json
GMAIL_POLL_SECONDS=30
GMAIL_ALLOWED_SENDERS=
GMAIL_INITIAL_UID=0

# Browser development origin. Use a comma-separated allowlist when expanded.
FRONTEND_ORIGIN=http://localhost:5173

# Domain assumptions pending confirmation; do not use to make bookings yet.
CAMPUS_TIMEZONE=Asia/Kolkata
BOOKING_SLOT_MINUTES=60
